# Environment Variables for HippoGrid
# Healthcare Infrastructure & Primary-care Planning Optimization Grid

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase / PostgreSQL Configuration
# Note: Use Supabase PostgreSQL as the primary persistent database.
# Never expose service_role secrets or database credentials to the frontend.
SUPABASE_URL=https://ucihhursqublehkxpqqm.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
DATABASE_URL=postgresql://postgres:your_password@db.ucihhursqublehkxpqqm.supabase.co:5432/postgres

# Frontend Environment Variables (Vite requires VITE_ prefix for exposed vars)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://ucihhursqublehkxpqqm.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
